---
import '../styles/fonts.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/global.css';
import muniRegular from '../fonts/muni-regular.ttf?url';
import muniBold from '../fonts/muni-bold.ttf?url';
import { withBase } from '../lib/framework';
import MuniArtsLogo from '../components/MuniArtsLogo.astro';

interface Props {
  title: string;
  description?: string;
  current?: 'ramec' | 'jak' | 'o-projektu';
  noindex?: boolean;
}

const { title, description = 'Kompetenční rámec studentů a studentek učitelství pro střední školy.', current, noindex = false } = Astro.props;
const nav = [
  { id: 'jak', label: 'Jak nástroj použít', path: 'jak-pracovat/' },
  { id: 'o-projektu', label: 'O nástroji', path: 'o-projektu/' },
] as const;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="cs" data-base={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0000DC" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preload" href={muniRegular} as="font" type="font/ttf" crossorigin />
    <link rel="preload" href={muniBold} as="font" type="font/ttf" crossorigin />
    <title>{title} | KRAAU</title>
  </head>
  <body>
    <a class="skip-link" href="#obsah">Přejít na obsah</a>
    <header class="site-header">
      <div class="shell site-header__inner">
        <a class="brand" href={withBase('')} aria-label="KRAAU, úvodní stránka">
          <span class="brand__mark" aria-hidden="true">K</span>
          <span class="brand__text"><strong>KRAAU</strong><small>Kompetenční rámec SŠ</small></span>
        </a>
        <nav class="desktop-nav" aria-label="Hlavní navigace">
          {nav.map((item) => <a class:list={{ active: current === item.id }} href={withBase(item.path)} aria-current={current === item.id ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <a class="header-search" href={withBase('hledat/')} aria-label="Hledat v rámci" title="Hledat v rámci">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><span class="sr-only">Hledat v rámci</span>
        </a>
        <details class="mobile-nav">
          <summary aria-label="Otevřít nabídku" title="Nabídka"><i class="fa-solid fa-bars" aria-hidden="true"></i></summary>
          <nav aria-label="Mobilní navigace">
            {nav.map((item) => <a href={withBase(item.path)} aria-current={current === item.id ? 'page' : undefined}>{item.label}</a>)}
            <a href={withBase('hledat/')}>Hledat</a>
          </nav>
        </details>
        <span class="header-divider" aria-hidden="true"></span>
        <a class="header-faculty" href="https://www.phil.muni.cz/" title="Filozofická fakulta Masarykovy univerzity"><MuniArtsLogo full class="header-faculty__full" /><MuniArtsLogo class="header-faculty__compact" /></a>
      </div>
    </header>
    <main id="obsah"><slot /></main>
    <footer class="site-footer">
      <div class="shell site-footer__inner">
        <a class="site-footer__faculty" href="https://www.phil.muni.cz/" title="Filozofická fakulta Masarykovy univerzity"><MuniArtsLogo /></a>
        <div><strong>KRAAU</strong><p>Kompetenční rámec studentů a studentek učitelství pro střední školy.</p></div>
        <div class="site-footer__links">
          {nav.map((item) => <a href={withBase(item.path)}>{item.label}</a>)}
        </div>      </div>
      <div class="funding">
        <div class="shell funding__inner">
          <img class="funding__logo" src={withBase('logolink-eu-msmt.svg')} alt="Spolufinancováno Evropskou unií; Ministerstvo školství, mládeže a tělovýchovy" width="445" height="62" loading="lazy" />
          <p>Tento produkt vznikl v rámci projektu MUNI 4 PREGRAD (reg. č. CZ.02.02.XX/00/23_019/0008395), který je spolufinancován Evropskou unií.</p>
        </div>
      </div>
    </footer>
    <div class="secret-toast" data-secret-toast data-kabinet={withBase('kabinet/')} role="status" aria-live="polite" hidden></div>
  </body>
</html>

<script>
  /* Skryté kurikulum: Konami kód (↑ ↑ ↓ ↓ ← → ← → B A) zapne „God Mode: Komenský“. */
  const sequence = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let position = 0;
  document.addEventListener('keydown', (event) => {
    const target = event.target as HTMLElement;
    if (target.closest('input, textarea, select, [contenteditable]')) return;
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    position = key === sequence[position] ? position + 1 : key === sequence[0] ? 1 : 0;
    if (position < sequence.length) return;
    position = 0;
    document.documentElement.classList.add('god-mode');
    const toast = document.querySelector<HTMLElement>('[data-secret-toast]');
    if (!toast) return;
    toast.replaceChildren();
    const eyebrow = document.createElement('p');
    eyebrow.className = 'eyebrow';
    eyebrow.textContent = 'Skryté kurikulum';
    const title = document.createElement('strong');
    title.textContent = 'God Mode: Komenský';
    const text = document.createElement('p');
    text.textContent = 'Všechny kompetence odemčeny. Bohužel pouze v tomto prohlížeči. Ve třídě musíš pořád učit.';
    const link = document.createElement('a');
    link.href = toast.dataset.kabinet!;
    link.textContent = 'Odměna čeká v kabinetu';
    const close = document.createElement('button');
    close.type = 'button';
    close.className = 'secret-toast__close';
    close.setAttribute('aria-label', 'Zavřít');
    close.innerHTML = '<i class="fa-solid fa-xmark" aria-hidden="true"></i>';
    close.addEventListener('click', () => { toast.hidden = true; });
    toast.append(close, eyebrow, title, text, link);
    toast.hidden = false;
  });
</script>
