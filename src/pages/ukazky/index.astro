---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { exampleTypeIcon, exampleUrl, getExamples, withBase } from '../../lib/framework';
const examples = await getExamples();
---
<SiteLayout title="Ukázky z praxe" current="ukazky">
  <div class="shell"><Breadcrumbs items={[{ label: 'Úvod', href: withBase('') }, { label: 'Ukázky z praxe' }]} />
    <header class="page-heading"><p class="eyebrow">Ilustrátory</p><h1>Ukázky z praxe</h1><p class="lede">Konkrétní situace, dokumenty a reflexe budou postupně propojovat deskriptory s děním ve třídě.</p></header>
    <section class="page-section">
      {examples.length > 0 ? <ul class="level-examples level-examples--list">
        {examples.map((example) => <li>
          <a class="level-example" href={exampleUrl(example.id)}>
            <span class="level-example__icon" aria-hidden="true"><i class={`fa-solid ${exampleTypeIcon[example.type]}`}></i></span>
            <span class="level-example__text">
              <small>{example.type} · {example.links.map((link) => `${link.criterionId}/${link.level}`).join(', ')}{example.status === 'draft' && ' · koncept'}</small>
              <span>{example.title}</span>
            </span>
            <i class="fa-solid fa-arrow-right level-example__arrow" aria-hidden="true"></i>
          </a>
        </li>)}
      </ul> : <div class="empty-state"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><h2>Ukázky zatím nejsou zveřejněné</h2><p>Na této stránce se objeví po odborném schválení a ověření souhlasů. Jednotlivá kritéria a jejich úrovně jsou již dostupné v rámci.</p><a class="button" href={withBase('ramec/')}>Procházet rámec <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>}
    </section>
  </div>
</SiteLayout>
