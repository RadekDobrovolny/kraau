---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import MergeGame from '../../components/MergeGame.astro';
import { criterionUrl, withBase } from '../../lib/framework';
import { excuses, ghosts } from '../../lib/hiddenCurriculum';
import { arcadePreviewEnabled } from '../../lib/arcade';
/* KRAAU Arcade je jen ve vývojovém náhledu (src/lib/arcade.ts). V produkčním buildu
   ji astro.config.mjs nahradí prázdnou komponentou, takže se kód ani data nesestaví. */
import ArcadeComponent from '../../components/arcade/Arcade.astro';
const Arcade = arcadePreviewEnabled ? ArcadeComponent : null;
const alibiData = excuses.map((excuse) => ({ ...excuse, ghost: ghosts[excuse.ghost] }));
const first = alibiData[0];
---
<SiteLayout title="Easter egg" description="Skryté kurikulum webu KRAAU." noindex>
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Úvod', href: withBase('') }, { label: 'Easter egg' }]} />
    <header class="page-heading">
      <p class="eyebrow">KRAAU: Skryté kurikulum</p>
      <h1>Easter egg</h1>
      <p class="lede">Sem se oficiálně nechodí. Vedle rámce s 61 kritérii existuje i druhá vrstva, kterou člověk objevuje zvídavostí. Nic z toho není součástí kompetenčního rámce.</p>
    </header>

    <section class="kabinet-section egg-context" id="proc" aria-labelledby="why-heading">
      <h2 id="why-heading">Proč weby a hry schovávají easter eggy?</h2>
      <div class="egg-context__body">
        <p>Easter egg (velikonoční vajíčko) je skrytá drobnost, kterou autoři schovají do hry, programu nebo webu. Najde ji jen ten, kdo zkouší, kliká a nespokojí se s tím, co je vidět na první pohled. Jako vajíčka při velikonočním hledání.</p>
        <p>Za nejslavnější první easter egg se považuje hra <em>Adventure</em> pro Atari 2600 (1980). Firma tehdy autory her nikde neuváděla, a tak programátor Warren Robinett schoval do skryté místnosti nápis se svým jménem. Od té doby se easter eggy objevují všude: tajné kódy ve hrách (nejznámější je Konami kód ↑ ↑ ↓ ↓ ← → ← → B A), vtípky ve vyhledávačích nebo malé hry v aplikacích.</p>
        <p>Proč je autoři dělají? Aby za webem byli vidět lidé, ne jen systém. Aby odměnili zvídavost a dali objeviteli radost z vlastního nálezu. A trochu i proto, že to baví je samotné. Pro nástroj o učení se to hodí dvojnásob: nejlépe si pamatujeme to, na co jsme přišli sami.</p>
      </div>
    </section>

    <section class="kabinet-section" id="vajicka" aria-labelledby="hints-heading">
      <h2 id="hints-heading">Co všechno se na webu skrývá</h2>
      <ul class="egg-list">
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-hand-pointer"></i></span><div><strong>Tajná sedmá oblast</strong><p>Na <a href={withBase('')}>úvodní stránce</a> rychle sedmkrát klikněte na logo KRAAU. Odemkne se oblast „Umění přežít učitelství“.</p></div></li>
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-dice-four"></i></span><div><strong>Neoficiální úroveň 4</strong><p>Rámec končí úrovní 3. U kteréhokoli kritéria dvakrát klikněte na kolečko s trojkou, třeba u <a href={criterionUrl('4.2.4')}>kritéria 4.2.4</a>.</p></div></li>
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-gamepad"></i></span><div><strong>Konami kód a God Mode</strong><p>Stiskněte na klávesnici Konami kód <span class="egg-keys"><kbd>↑</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>↓</kbd><kbd>←</kbd><kbd>→</kbd><kbd>←</kbd><kbd>→</kbd><kbd>B</kbd><kbd>A</kbd></span> (mimo textové pole). Web zezlátne a úroveň 4 se odemkne u všech 61 kritérií.</p></div></li>
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-magnifying-glass"></i></span><div><strong>Tajná hesla ve vyhledávání</strong><p>Do <a href={withBase('hledat/')}>vyhledávání</a> zkuste napsat třeba 42, kávu, inspekci, AI, Komenského nebo prokrastinaci.</p></div></li>
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-link-slash"></i></span><div><strong>Chyba jako příležitost</strong><p>Zadejte adresu stránky, která neexistuje. I chybějící stránka umí vést k reflexi.</p></div></li>
        <li><span class="egg-list__icon" aria-hidden="true"><i class="fa-solid fa-puzzle-piece"></i></span><div><strong>A tady níž</strong><p>{Arcade
          ? <><a href="#arcade">KRAAU Arcade</a> se šesti hrami včetně hry Praxe na druhou, ve které ze zkušeností vyroste Zuzana&nbsp;Š., a </>
          : <>hra <a href="#hra">Praxe na druhou</a>, ve které ze zkušeností vyroste Zuzana&nbsp;Š., a </>}<a href="#alibista">Akademický alibista</a> s výmluvami pro každou hodinu.</p></div></li>
      </ul>
    </section>

    {Arcade ? (
      /* Náhled: herna jako katalog; každá hra má vlastní stránku easter-egg/hry/<slug>/. */
      <section class="kabinet-section kabinet-section--arcade" id="arcade" aria-label="KRAAU Arcade">
        <Arcade reviewPreview={true} />
      </section>
    ) : (
      <section class="kabinet-section" id="hra" aria-labelledby="game-heading">
        <div class="section-heading"><div><p class="eyebrow">Přestávka mezi hodinami</p><h2 id="game-heading">Praxe na druhou</h2><p>Šipkami nebo tahem prstem posouvejte dlaždice. Dvě stejné se spojí ve vyšší stupeň. Z nápadů vznikají přípravy, z hospitací zpětná vazba… a na konci čeká Zuzana&nbsp;Š. (2048).</p></div></div>
        <MergeGame />
      </section>
    )}

    <section class="kabinet-section" id="alibista" aria-labelledby="alibi-heading">
      <p class="eyebrow">KRAAU Labs / Experimentální nástroj</p>
      <h2 id="alibi-heading">Akademický alibista 1.0</h2>
      <p class="alibi-intro">Stroj na výmluvy promítne na interaktivní tabuli tu pravou. A Sborovna nesmrtelných ji hned okomentuje.</p>
      <div class="alibi-room" data-alibi data-excuses={JSON.stringify(alibiData)}>
        <figure class="smartboard">
          <div class="smartboard__screen">
            <div class="smartboard__bar" aria-hidden="true"><span>Výmluva dne</span><span class="smartboard__live"><i></i>Generátor běží</span></div>
            <blockquote class="smartboard__text" data-alibi-text aria-live="polite">{first.text}</blockquote>
            <span class="smartboard__scan" aria-hidden="true"></span>
          </div>
        </figure>
        <aside class="ghost-comment" data-ghost aria-live="polite" aria-labelledby="ghost-heading">
          <p class="ghost-comment__label" id="ghost-heading"><i class="fa-solid fa-ghost" aria-hidden="true"></i> Sborovna nesmrtelných</p>
          <div class="ghost-comment__bubble">
            <p class="ghost-comment__text" data-ghost-comment>{first.comment}</p>
            <p class="ghost-comment__who"><strong data-ghost-name>{first.ghost.name}</strong> <span data-ghost-years>({first.ghost.years})</span></p>
          </div>
          <span class="ghost-comment__ghost" aria-hidden="true"><i class="fa-solid fa-ghost"></i></span>
        </aside>
      </div>
      <button type="button" class="button" data-alibi-next><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> Generovat výmluvu</button>
      <p class="meta">Nástroj není určen k použití při reflexi pedagogické praxe. Nebo právě naopak. Nesmrtelní mluví volně podle svých myšlenek, jejich výroky jsou smyšlené.</p>
    </section>
  </div>
</SiteLayout>

<script>
  /* Akademický alibista a Sborovna nesmrtelných */
  type AlibiItem = { text: string; comment: string; ghost: { name: string; years: string } };
  document.querySelectorAll<HTMLElement>('[data-alibi]').forEach((room) => {
    const items: AlibiItem[] = JSON.parse(room.dataset.excuses ?? '[]');
    const text = room.querySelector<HTMLElement>('[data-alibi-text]')!;
    const ghost = room.querySelector<HTMLElement>('[data-ghost]')!;
    const comment = room.querySelector<HTMLElement>('[data-ghost-comment]')!;
    const name = room.querySelector<HTMLElement>('[data-ghost-name]')!;
    const years = room.querySelector<HTMLElement>('[data-ghost-years]')!;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timers: number[] = [];
    /* Po dopsání výmluvy zmizí blikající kurzor. */
    text.addEventListener('animationend', (event) => { if (event.animationName === 'board-type') text.classList.remove('smartboard__text--typing'); });
    const restart = (element: HTMLElement, className: string) => { element.classList.remove(className); void element.offsetWidth; element.classList.add(className); };
    document.querySelector('[data-alibi-next]')?.addEventListener('click', () => {
      let next = current;
      while (items.length > 1 && next === current) next = Math.floor(Math.random() * items.length);
      current = next;
      const item = items[current];
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = [];
      const write = () => {
        text.textContent = item.text;
        restart(text, 'smartboard__text--typing');
      };
      const haunt = () => {
        comment.textContent = item.comment;
        name.textContent = item.ghost.name;
        years.textContent = `(${item.ghost.years})`;
        restart(ghost, 'ghost-comment--appear');
      };
      if (calm) { write(); haunt(); return; }
      restart(room, 'alibi-room--scanning');
      ghost.classList.remove('ghost-comment--appear');
      ghost.classList.add('ghost-comment--gone');
      timers.push(window.setTimeout(write, 520));
      timers.push(window.setTimeout(() => { ghost.classList.remove('ghost-comment--gone'); haunt(); }, 1500));
    });
  });

</script>
