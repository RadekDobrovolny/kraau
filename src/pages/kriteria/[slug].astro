---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelViewer from '../../components/LevelViewer.astro';
import OwlIcon from '../../components/OwlIcon.astro';import type { Area, Competence, Criterion } from '../../lib/framework';
import { areaUrl, competenceUrl, criterionUrl, displayTitle, getExamples, getFramework, pdfUrl, slug, withBase } from '../../lib/framework';

interface Props { area: Area; competence: Competence; criterion: Criterion; previous?: Criterion; next?: Criterion }
export async function getStaticPaths() {
  const { areas, competences, criteria } = await getFramework();
  return criteria.map((criterion, position) => {
    const competence = competences.find((item) => item.id === criterion.competenceId)!;
    return { params: { slug: slug(criterion.id) }, props: {
      area: areas.find((item) => item.id === competence.areaId)!,
      competence,
      criterion,
      previous: criteria[position - 1],
      next: criteria[position + 1],
    } };
  });
}
const { area, competence, criterion, previous, next } = Astro.props;
const examples = (await getExamples()).filter((example) => example.links.some((link) => link.criterionId === criterion.id));
---
<SiteLayout title={`${criterion.id} ${displayTitle(criterion.title)}`} description={`${criterion.id}: ${displayTitle(criterion.title).replace(/[.!?]$/, '')}. Čtyři úrovně rozvoje a mindset.`} current="ramec">
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Rámec', href: withBase('ramec/') }, { label: displayTitle(area.title), href: areaUrl(area.id) }, { label: `${competence.id} ${displayTitle(competence.title)}`, href: competenceUrl(competence.id) }, { label: `Kritérium ${criterion.id}` }]} />
    <article class="criterion-main">
      <header class="criterion-header"><div><p class="eyebrow">Kritérium {criterion.id}</p><h1 class="criterion-title">{displayTitle(criterion.title)}</h1><p class="criterion-context">{competence.id} {displayTitle(competence.title)}</p></div></header>
      <section class="mindset" id="mindset" aria-labelledby="mindset-heading"><div class="mindset__heading"><span class="mindset__icon" aria-hidden="true"><OwlIcon /></span><div><p class="eyebrow">Mindset</p><h2 id="mindset-heading">Co stojí za jednáním</h2></div></div><div class="mindset__body"><p>{criterion.mindset}</p></div></section>
      <LevelViewer criterion={criterion} examples={examples} />
      <section class="reflection" aria-labelledby="reflection-heading"><p class="eyebrow">Pro reflexi nebo společný rozhovor</p><h2 id="reflection-heading">Co z toho plyne pro příští výuku?</h2><ol><li>Co jste v konkrétní situaci pozorovali?</li><li>Který popis jednání je situaci nejbližší a proč?</li><li>Jaký jeden krok vyzkoušíte příště?</li></ol></section>
      <section class="criterion-actions" aria-label="Zdroj a tisk">
        <a class="criterion-action" href={pdfUrl(criterion.sourcePage)} target="_blank" rel="noopener noreferrer">
          <span class="criterion-action__icon" aria-hidden="true"><i class="fa-regular fa-file-pdf"></i></span>
          <span class="criterion-action__text"><strong>Zdrojový dokument <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></strong><small>Kompetenční rámec studentů a studentek učitelství pro střední školy, strana {criterion.sourcePage}</small></span>
        </a>
        <button type="button" class="criterion-action" data-print>
          <span class="criterion-action__icon" aria-hidden="true"><i class="fa-solid fa-print"></i></span>
          <span class="criterion-action__text"><strong>Vytisknout nebo uložit jako PDF</strong><small>Tato stránka se všemi úrovněmi, mindsetem a otázkami k reflexi</small></span>
        </button>
      </section>
      <nav class="criterion-pager" aria-label="Pohyb mezi kritérii">
        <div>{previous && <a href={criterionUrl(previous.id)} aria-label={`Předchozí kritérium ${previous.id}: ${displayTitle(previous.title)}`} title={displayTitle(previous.title)}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span><small>Předchozí kritérium</small><strong>{previous.id}</strong><span class="criterion-pager__title">{displayTitle(previous.title)}</span></span></a>}</div>
        <div>{next && <a href={criterionUrl(next.id)} aria-label={`Další kritérium ${next.id}: ${displayTitle(next.title)}`} title={displayTitle(next.title)}><span><small>Další kritérium</small><strong>{next.id}</strong><span class="criterion-pager__title">{displayTitle(next.title)}</span></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}</div>
      </nav>
      <p class="print-only print-source">Zdroj: Kompetenční rámec studentů a studentek učitelství pro střední školy, strana {criterion.sourcePage}. Online: {new URL(criterionUrl(criterion.id), Astro.site).toString()}</p>
    </article>
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((button) => button.addEventListener('click', () => window.print()));
</script>
