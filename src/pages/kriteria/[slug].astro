---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelViewer from '../../components/LevelViewer.astro';
import type { Area, Competence, Criterion } from '../../lib/framework';
import { areaUrl, competenceUrl, criterionUrl, displayTitle, getFramework, pdfUrl, slug, withBase } from '../../lib/framework';

interface Props { area: Area; competence: Competence; criterion: Criterion; previous?: Criterion; next?: Criterion }
export async function getStaticPaths() {
  const { areas, competences, criteria } = await getFramework();
  return criteria.map((criterion, position) => {
    const competence = competences.find((item) => item.id === criterion.competenceId)!;
    return { params: { slug: slug(criterion.id) }, props: {
      area: areas.find((item) => item.id === competence.areaId)!,
      competence,
      criterion,
      previous: criteria[position - 1],
      next: criteria[position + 1],
    } };
  });
}
const { area, competence, criterion, previous, next } = Astro.props;
---
<SiteLayout title={`${criterion.id} ${displayTitle(criterion.title)}`} description={`${criterion.id}: ${displayTitle(criterion.title).replace(/[.!?]$/, '')}. Čtyři úrovně rozvoje a mindset.`} current="ramec">
  <div class="shell">
    <Breadcrumbs items={[{ label: 'Rámec', href: withBase('ramec/') }, { label: displayTitle(area.title), href: areaUrl(area.id) }, { label: `${competence.id} ${displayTitle(competence.title)}`, href: competenceUrl(competence.id) }, { label: `Kritérium ${criterion.id}` }]} />
    <article class="criterion-main">
      <header class="criterion-header"><div><p class="eyebrow">Kritérium {criterion.id}</p><h1 class="criterion-title">{displayTitle(criterion.title)}</h1><p class="criterion-context">{competence.id} {displayTitle(competence.title)}</p></div>
        <div class="criterion-tools"><button type="button" class="icon-button" data-copy-link aria-label="Kopírovat odkaz na kritérium" title="Kopírovat odkaz na kritérium"><i class="fa-solid fa-link" aria-hidden="true"></i></button><span class="meta" data-copy-status aria-live="polite"></span></div>
      </header>
      <nav class="criterion-pager" aria-label="Pohyb mezi kritérii">
        <div>{previous && <a href={criterionUrl(previous.id)} aria-label={`Předchozí kritérium ${previous.id}: ${displayTitle(previous.title)}`} title={displayTitle(previous.title)}><i class="fa-solid fa-arrow-left" aria-hidden="true"></i><span><small>Předchozí kritérium</small><strong>{previous.id}</strong><span class="criterion-pager__title">{displayTitle(previous.title)}</span></span></a>}</div>
        <div>{next && <a href={criterionUrl(next.id)} aria-label={`Další kritérium ${next.id}: ${displayTitle(next.title)}`} title={displayTitle(next.title)}><span><small>Další kritérium</small><strong>{next.id}</strong><span class="criterion-pager__title">{displayTitle(next.title)}</span></span><i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>}</div>
      </nav>
      <LevelViewer criterion={criterion} />
      <section class="mindset" id="mindset" aria-labelledby="mindset-heading"><div class="mindset__heading"><span class="mindset__icon" aria-hidden="true"><i class="fa-solid fa-brain"></i></span><div><p class="eyebrow">Mindset</p><h2 id="mindset-heading">Co stojí za jednáním</h2></div></div><div class="mindset__body"><p>{criterion.mindset}</p></div></section>
      <section class="reflection" aria-labelledby="reflection-heading"><p class="eyebrow">Pro reflexi nebo společný rozhovor</p><h2 id="reflection-heading">Co z toho plyne pro příští výuku?</h2><ol><li>Co jste v konkrétní situaci pozorovali?</li><li>Který popis jednání je situaci nejbližší a proč?</li><li>Jaký jeden krok vyzkoušíte příště?</li></ol></section>
      <div class="criterion-bottom"><p class="meta">Zdroj: pracovní verze Kompetenčního rámce pro střední školy, strana {criterion.sourcePage}. <a href={pdfUrl(criterion.sourcePage)} target="_blank" rel="noopener noreferrer">Zobrazit v PDF <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i></a></p></div>
    </article>
  </div>
</SiteLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => button.addEventListener('click', async () => {
    const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
    try {
      await navigator.clipboard.writeText(location.href);
      if (status) status.textContent = 'Odkaz zkopírován.';
    } catch {
      if (status) status.textContent = 'Odkaz se nepodařilo zkopírovat.';
    }
  }));
</script>
