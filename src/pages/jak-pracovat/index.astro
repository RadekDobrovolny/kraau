---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LevelViewer from '../../components/LevelViewer.astro';
import OwlIcon from '../../components/OwlIcon.astro';
import source from '../../data/framework.json';
import { criterionUrl, displayTitle, exampleTypeIcon, exampleUrl, getExamples, getFramework, withBase } from '../../lib/framework';
const { criteria } = await getFramework();
const sample = criteria.find((item) => item.id === '1.1.1')!;
const examples = await getExamples();
const toc = [
  ['postup', 'Tři kroky pro reflexi'],
  ['urovne', 'Co znamenají úrovně'],
  ['podle-role', 'Práce podle role'],
  ['ukazky', 'Ukázky z praxe'],
  ['vychodiska', 'Východiska rámce'],
];
---
<SiteLayout title="Jak nástroj použít" current="jak">
  <div class="shell"><Breadcrumbs items={[{ label: 'Úvod', href: withBase('') }, { label: 'Jak nástroj použít' }]} />
    <header class="page-heading"><p class="eyebrow">Metodika</p><h1>Jak nástroj použít</h1><p class="lede">Začněte konkrétní situací z výuky. Rámec vám pomůže pojmenovat jednání a domluvit jeden další krok.</p></header>
    <div class="content-layout">
      <div class="prose methodology-page">
        <h2 id="postup">Tři kroky pro reflexi</h2>
        <ol class="steps">
          <li><div><h3>Začněte pozorováním</h3><p>Popište, co se při výuce skutečně stalo. Vyberte téma nebo oblast, které se situace týká.</p></div></li>
          <li><div><h3>Porovnejte popisy jednání</h3><p>Otevřete příslušné kritérium a čtěte všechny čtyři úrovně. Hledejte nejbližší popis, nikoli známku. Všimněte si také profesního přesvědčení v oddílu mindset.</p></div></li>
          <li><div><h3>Domluvte další krok</h3><p>Pojmenujte jeden konkrétní postup, který lze při příští výuce zkusit a znovu reflektovat.</p></div></li>
        </ol>

        <h2 id="urovne">Co znamenají úrovně</h2>
        <p>Úrovně 0–3 popisují postupný rozvoj konkrétního profesního jednání. Jsou oporou pro reflexi a zpětnou vazbu, ne nálepkou pro člověka.</p>
        <p>Rámec sleduje, co lze během výuky pozorovat, dokumentovat a společně reflektovat. Úrovně pomáhají pojmenovat, co už se daří a kam může další profesní učení směřovat.</p>
        <p>Každé kritérium má vlastní čtyři deskriptory. Úroveň proto čtěte vždy v souvislosti s konkrétním kritériem a situací z praxe; samotné číslo nevypovídá o kvalitě učitele jako osoby.</p>
        <h3>Mindset patří ke kritériu</h3>
        <p>Vedle jednání rámec zachycuje také profesní přesvědčení: proč vyučující určitému postupu přikládá význam a jak uvažuje o učení žáků a žákyň. Mindset není další stupeň na škále.</p>
      </div>
      <aside class="content-layout__aside" aria-labelledby="toc-heading">
        <h2 id="toc-heading">Na této stránce</h2>
        <ul>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ul>
      </aside>
    </div>

    <section class="page-section methodology-sample" aria-labelledby="sample-heading">
      <div class="section-heading"><div><p class="eyebrow">Příklad</p><h2 id="sample-heading">Kritérium {sample.id}</h2><p>{displayTitle(sample.title)}</p></div><a class="text-link" style="white-space: nowrap" href={criterionUrl(sample.id)}>Otevřít detail <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></div>
      <section class="mindset" aria-labelledby="sample-mindset"><p class="eyebrow mindset__label">Mindset</p><div class="mindset__heading"><span class="mindset__icon" aria-hidden="true"><OwlIcon /></span><h3 id="sample-mindset">Co stojí za jednáním</h3></div><div class="mindset__body"><p>{sample.mindset}</p></div></section>
      <LevelViewer criterion={sample} examples={examples} />
    </section>

    <div class="prose methodology-page">
      <h2 id="podle-role">Práce podle role</h2>
      <div class="role-grid">
        <section><h3>Studující</h3><p>Vyberte situaci z vlastní výuky, popište své jednání a porovnejte je s nejbližšími deskriptory. Zvolte jeden další krok, který můžete zkusit při příští hodině.</p></section>
        <section><h3>Provázející učitelé</h3><p>Při zpětné vazbě začněte pozorovanými situacemi. Čtěte kritérium společně se studujícím a ptejte se, co daný postup podpořilo nebo brzdilo.</p></section>
        <section><h3>Vysokoškolští vzdělavatelé</h3><p>Propojujte kritéria s cíli kurzu a praxe. Používejte společné popisy jednání při plánování, pozorování i reflexi, aby navazující zkušenosti dávaly smysl.</p></section>
      </div>

      <h2 id="ukazky">Ukázky z praxe</h2>
      <p>Konkrétní situace, dokumenty a reflexe propojují popisy jednání s děním ve třídě. U kritéria je najdete ve sloupci „Ukázka z praxe“ vedle úrovně, kterou ilustrují.</p>
      {examples.length > 0
        ? <ul class="level-examples level-examples--list">
            {examples.map((example) => <li>
              <a class="level-example" href={exampleUrl(example.id)}>
                <span class="level-example__icon" aria-hidden="true"><i class={`fa-solid ${exampleTypeIcon[example.type]}`}></i></span>
                <span class="level-example__text">
                  <small>{example.type} · {example.links.map((link) => `${link.criterionId}/${link.level}`).join(', ')}{example.status === 'draft' && ' · koncept'}</small>
                  <span>{example.title}</span>
                </span>
                <i class="fa-solid fa-arrow-right level-example__arrow" aria-hidden="true"></i>
              </a>
            </li>)}
          </ul>
        : <div class="source-note"><i class="fa-regular fa-file-lines" aria-hidden="true"></i><div><strong>Ukázky zatím nejsou zveřejněné.</strong> Objeví se po odborném schválení a ověření souhlasů.</div></div>}

      <h2 id="vychodiska">Východiska rámce</h2>
      <details class="methodology-details"><summary>Východiska z původního dokumentu <i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary><div>{source.methodology.map((paragraph) => <p>{paragraph}</p>)}</div></details>
    </div>
  </div>
</SiteLayout>
