---
import type { Area, Competence, Criterion } from '../lib/framework';
import { criterionUrl, displayTitle } from '../lib/framework';

interface Props { areas: Area[]; competences: Competence[]; criteria: Criterion[] }
const { areas, competences, criteria } = Astro.props;
---
<div class="framework-explorer" aria-label="Oblasti kompetenčního rámce" data-framework-explorer>
  <div class="framework-explorer__tools" data-explorer-tools hidden>
    <button type="button" class="text-button" data-toggle-all aria-expanded="false"><i class="fa-solid fa-angles-down" aria-hidden="true"></i><span>Rozbalit vše</span></button>
  </div>
  {areas.map((area) => {
    const areaCompetences = competences.filter((item) => item.areaId === area.id);
    const areaCriteriaCount = criteria.filter((item) => item.competenceId.startsWith(`${area.id}.`)).length;
    return <details class="framework-area" name="framework-area">
      <summary><span class="framework-area__number">{area.id.padStart(2, '0')}</span><span class="framework-area__title">{area.title}</span><span class="framework-area__count">{areaCriteriaCount} kritérií</span><i class="fa-solid fa-chevron-down" aria-hidden="true"></i></summary>
      <div class="framework-area__content">
        {areaCompetences.map((competence) => <section class="framework-competence" aria-labelledby={`competence-${competence.id}`}>
          <h2 id={`competence-${competence.id}`}><span>{competence.id}</span> {displayTitle(competence.title)}</h2>
          <ul>{criteria.filter((criterion) => criterion.competenceId === competence.id).map((criterion) => <li><a href={criterionUrl(criterion.id)}><span>{criterion.id}</span>{displayTitle(criterion.title)}<i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a></li>)}</ul>
        </section>)}
      </div>
    </details>;
  })}
</div>

<script>
  /* „Rozbalit vše“: oblasti se jinak chovají jako akordeon (otevřená je vždy jen jedna, atribut name). */
  document.querySelectorAll<HTMLElement>('[data-framework-explorer]').forEach((explorer) => {
    const tools = explorer.querySelector<HTMLElement>('[data-explorer-tools]')!;
    const button = tools.querySelector<HTMLButtonElement>('[data-toggle-all]')!;
    const label = button.querySelector('span')!;
    const icon = button.querySelector('i')!;
    const areas = [...explorer.querySelectorAll<HTMLDetailsElement>('details.framework-area')];
    const update = () => {
      const allOpen = areas.every((area) => area.open);
      label.textContent = allOpen ? 'Sbalit vše' : 'Rozbalit vše';
      icon.className = `fa-solid ${allOpen ? 'fa-angles-up' : 'fa-angles-down'}`;
      button.setAttribute('aria-expanded', String(allOpen));
    };
    button.addEventListener('click', () => {
      const expand = !areas.every((area) => area.open);
      areas.forEach((area) => {
        if (expand) area.removeAttribute('name');
        area.open = expand;
        if (!expand) area.setAttribute('name', 'framework-area');
      });
      update();
    });
    areas.forEach((area) => area.addEventListener('toggle', update));
    tools.hidden = false;
    update();
  });
</script>
