---
import type { Criterion, Example } from '../lib/framework';
import { exampleTypeIcon, exampleUrl } from '../lib/framework';
import type { SecretLevel } from '../lib/hiddenCurriculum';
interface Props { criterion: Criterion; examples?: Example[]; secretLevel?: SecretLevel }
const { criterion, examples = [], secretLevel } = Astro.props;
const examplesFor = (level: number) =>
  examples.filter((example) => example.links.some((link) => link.criterionId === criterion.id && link.level === level));
---
<section class="level-viewer" aria-labelledby="levels-heading">
  <h2 id="levels-heading" class="sr-only">Úrovně profesního rozvoje</h2>
  <div class="level-grid">
    <div class="level-grid__head"><span>Úroveň</span><span>Popis profesního jednání</span><span class="level-grid__head-examples">Ukázka z praxe</span></div>
    {criterion.levels.map((text, level) => {
      const levelExamples = examplesFor(level);
      return <section class="level-panel" id={`uroven-${level}`} data-level-panel={level} aria-labelledby={`level-heading-${level}`}>
        <h3 id={`level-heading-${level}`}><span class="sr-only">Úroveň </span><span class="level-panel__number">{level}</span></h3>
        <p>{text}</p>
        <div class="level-panel__examples">
          {levelExamples.length > 0 && <ul aria-label={`Ukázky z praxe k úrovni ${level}`}>
            {levelExamples.map((example) => <li>
              <a class="level-marker" href={exampleUrl(example.id)} title={example.title} aria-label={`Ukázka z praxe (${example.type}): ${example.title}`}>
                <span class="level-marker__circle" aria-hidden="true"><i class={`fa-solid ${exampleTypeIcon[example.type]}`}></i></span>
                <span class="level-marker__label" aria-hidden="true">Ukázka<span class="level-marker__suffix"> z praxe</span></span>
              </a>
            </li>)}
          </ul>}
        </div>
      </section>;
    })}
    {secretLevel && <section class="level-panel level-panel--secret" data-secret-level hidden aria-labelledby="level-heading-secret">
      <h3 id="level-heading-secret"><span class="sr-only">Neoficiální úroveň </span><span class="level-panel__number">4</span></h3>
      <div>
        <p class="level-panel__secret-badge"><i class="fa-solid fa-key" aria-hidden="true"></i> Neoficiální úroveň · skryté kurikulum</p>
        <p><strong>Úroveň 4 · {secretLevel.title}</strong></p>
        <p>{secretLevel.text}</p>
        <p class="level-panel__secret-note">Tuto úroveň rámec nezná. Objevili jste ji dvojklikem na trojku. Dalším dvojklikem ji zase schováte.</p>
      </div>
    </section>}
  </div>
</section>

<script>
  /* Skryté kurikulum: dvojklik na číslo 3 odhalí neoficiální úroveň 4 (jen u kritérií, která ji mají). */
  const secret = document.querySelector<HTMLElement>('[data-secret-level]');
  const three = document.querySelector<HTMLElement>('[data-level-panel="3"] .level-panel__number');
  three?.addEventListener('dblclick', () => {
    if (!secret) return;
    secret.hidden = !secret.hidden;
    window.getSelection()?.removeAllRanges();
    if (!secret.hidden) secret.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });
</script>
